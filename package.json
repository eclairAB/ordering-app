{
  "name": "ordering-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @ordering/server start",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @ordering/server db:migrate",
    "db:seed": "pnpm --filter @ordering/server db:seed",
    "loadtest": "k6 run deploy/loadtest/orders.js",
    "release": "bash deploy/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
