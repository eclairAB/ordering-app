{
  "name": "@ordering/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@ordering/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5"
  }
}
